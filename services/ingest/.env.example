# Copy to .env for local runs (npm run dev). On AWS the task definition sets these, with the
# secrets coming from SSM Parameter Store.

# --- required ---
OPENAI_API_KEY=
# vectors_ingest role; compose.dev.yml's database:
VECTORS_DATABASE_URL=postgresql://vectors_ingest:dev@localhost:5432/vectors

# --- optional (values shown are the defaults) ---
# a directory, or s3://<bucket>/knowledge-base on AWS
# KNOWLEDGE_BASE_PATH=./knowledge-base

# govbot_ingest role on the metadata database; executive order rows aren't updated without it
# GOVBOT_DATABASE_URL=postgresql://govbot_ingest:dev@localhost:5432/govbot

# shared with rag-api; changing either means a re-ingest (and for dimensions, a migration)
# EMBEDDING_MODEL=text-embedding-3-large
# EMBEDDING_DIMENSIONS=3072
# CHUNKING_MODEL=gpt-4.1-nano

# DOTENV_CONFIG_QUIET=true
