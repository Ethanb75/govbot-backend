# Copy to .env for local runs (npm run dev). In deployment, compose.yml sets everything except
# OPENAI_API_KEY, which Jenkins writes into .env from the openai-api-key credential.

# --- required ---
OPENAI_API_KEY=
QDRANT_URL=http://192.168.1.131:6333
QDRANT_COLLECTION_NAME=knowledge

# --- optional (values shown are the defaults) ---
# only needed if the vector db has an api key set
# QDRANT_API_KEY=

# must match what knowledge-ingest embedded the collection with
# EMBEDDING_MODEL=text-embedding-3-large
# EMBEDDING_DIMENSIONS=3072

# REWRITE_MODEL=gpt-4.1-nano
# RERANK_MODEL=gpt-4.1-nano
# ANSWER_MODEL=gpt-4.1-nano

# chunks fetched per lookup, and chunks kept after reranking
# RETRIEVAL_K=20
# FINAL_K=10

# IP of the reverse proxy allowed to set X-Forwarded-For; leave unset locally
# TRUSTED_PROXY=
# requests per minute per client IP (health checks are exempt)
# RATE_LIMIT_PER_MINUTE=10

# HOST=0.0.0.0
# PORT=8090
# DOTENV_CONFIG_QUIET=true
