# Copy to .env for local runs (npm run dev). On AWS the task definition sets these, with the
# secrets coming from SSM Parameter Store.

# --- required ---
OPENAI_API_KEY=
# read-only vectors_app role; compose.dev.yml's database:
VECTORS_DATABASE_URL=postgresql://vectors_app:dev@localhost:5432/vectors

# --- optional (values shown are the defaults) ---
# read-only govbot_app role on the metadata database; the executive order tool is off without it
# GOVBOT_DATABASE_URL=postgresql://govbot_app:dev@localhost:5432/govbot

# must match what ingest embedded the chunks with
# EMBEDDING_MODEL=text-embedding-3-large
# EMBEDDING_DIMENSIONS=3072

# REWRITE_MODEL=gpt-4.1-nano
# RERANK_MODEL=gpt-4.1-nano
# ANSWER_MODEL=gpt-4.1-nano
# JUDGE_MODEL=gpt-5.4-mini

# Cloudflare Workers AI, for the intent check; skipped if either is unset
# CLOUDFLARE_WORKER_API_KEY=
# CLOUDFLARE_WORKER_ACCOUNT_ID=
# INTENT_MODEL=@cf/cloudflare/clef

# chunks fetched per lookup, kept after reranking, and returned per knowledge base tool call
# RETRIEVAL_K=20
# FINAL_K=10
# TOOL_K=5

# proxies in front that append to X-Forwarded-For: 2 behind CloudFront -> ALB, 0 locally
# TRUST_PROXY_HOPS=0
# requests per minute per client IP (health checks are exempt)
# RATE_LIMIT_PER_MINUTE=10

# HOST=0.0.0.0
# PORT=8090
# debug also logs questions, answers and tool calls
# LOG_LEVEL=info
# DOTENV_CONFIG_QUIET=true
